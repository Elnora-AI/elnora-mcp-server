# Required — Elnora backend API URL
ELNORA_API_URL=https://platform.elnora.ai/api/v1

# Required — Token validation endpoint
ELNORA_TOKEN_VALIDATION_URL=https://platform.elnora.ai/api/v1/auth/validate-token

# Required — Public-facing URL of this MCP server (must be HTTPS in production)
ELNORA_PUBLIC_URL=https://mcp.elnora.ai

# Required — Platform login page URL (must be HTTPS in production)
ELNORA_LOGIN_URL=https://platform.elnora.ai/login

# Required — Platform token exchange endpoint
ELNORA_TOKEN_EXCHANGE_URL=https://platform.elnora.ai/api/v1/auth/token

# Required — OAuth client credentials for this MCP server at the platform
ELNORA_PLATFORM_CLIENT_ID=mcp-server
ELNORA_PLATFORM_CLIENT_SECRET=your-client-secret-here

# Required — Service key for platform token validation endpoint (X-Service-Key header)
ELNORA_MCP_SERVICE_KEY=your-mcp-service-key-here

# Required — Redis URL for token persistence (use rediss:// for TLS in production)
REDIS_URL=redis://localhost:6379

# Optional — Allow hosted (non-loopback) OAuth clients to register and connect.
# When "true", non-loopback clients (e.g. claude.ai) may self-register and complete the flow after
# the user approves them on the MCP-server consent screen; they are capped to read-only scopes.
# When unset/false (default), only loopback clients (CLI / local IDE) are allowed, everywhere.
# ELNORA_MCP_ALLOW_HOSTED_CLIENTS=false

# Optional — Server port (default: 3000)
PORT=3000

# Optional — Bind host (default: 0.0.0.0)
HOST=0.0.0.0

# Optional — Additional CORS origins (comma-separated)
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
