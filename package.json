{
  "name": "@elnora-ai/mcp-server",
  "version": "1.7.7",
  "mcpName": "io.github.Elnora-AI/elnora-mcp-server",
  "description": "MCP server for Elnora Platform — AI-powered bioprotocol optimization",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "docs:reference": "tsx scripts/gen-docs-reference.ts",
    "clean": "node --input-type=commonjs -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Elnora-AI/elnora-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/Elnora-AI/elnora-mcp-server/issues"
  },
  "homepage": "https://elnora.ai",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "elnora",
    "bioprotocol",
    "ai-agent",
    "lab-protocol"
  ],
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "axios": "1.19.0",
    "express": "^5.1.0",
    "express-rate-limit": "8.6.2",
    "ioredis": "^5.11.1",
    "zod": "^4.4.1"
  },
  "overrides": {
    "body-parser": ">=2.3.0",
    "form-data": ">=4.0.6",
    "qs": ">=6.16.0",
    "fast-uri": ">=4.1.3",
    "ip-address": ">=10.2.2",
    "hono": "^4.13.3",
    "postcss": ">=8.5.26",
    "@hono/node-server": "^2.0.5",
    "follow-redirects": ">=1.16.0",
    "tar": "^7.5.11",
    "minimatch": "^10.2.4",
    "path-to-regexp": "^8.4.0",
    "vite": ">=8.0.5",
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.4.0",
    "tsx": "4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
